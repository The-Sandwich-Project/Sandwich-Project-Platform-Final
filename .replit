modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-22_11"
packages = ["cairo", "chromium", "ffmpeg-full", "freetype", "ghostscript", "glib", "glibcLocales", "gobject-introspection", "gtk3", "jq", "killall", "nano", "nss", "pkg-config", "qhull", "sqlite-interactive", "tcl", "tk", "tree", "zip"]

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "NODE_OPTIONS=--max-old-space-size=4096 npm run build"]
run = "NODE_ENV=production node dist/index.js"
ignorePorts = false

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 4242
externalPort = 3001

[[ports]]
localPort = 4983
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Server"
mode = "sequential"
author = 43025137

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[objectStorage]
defaultBucketID = "replit-objstore-5c569e23-2e8a-423a-87c9-b9bf6fd00d94"

[agent]
integrations = ["javascript_sendgrid:1.0.0", "javascript_database:1.0.0", "twilio:1.0.0", "javascript_openai_ai_integrations:1.0.0", "javascript_object_storage:2.0.0"]

[userenv]

[userenv.development]
APP_ENV = "development"
PLANNING_SHEET_ID = "1LQV0CNCsqNvBmSSnruP2MrsLSx1DzCjUQ9W8rjKbyuE"

[userenv.production]
APP_ENV = "production"
CLIENT_URL = "https://sandwich-project-platform-final-katielong2316.replit.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
